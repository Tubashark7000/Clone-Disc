{
  "name": "voidisce-desktop",
  "version": "1.0.0",
  "description": "Voidisce — salas de voz, câmera e compartilhamento de tela",
  "main": "main.js",
  "private": true,
  "author": "Voidisce",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "debug": "electron . --debug",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.Voidisce.desktop",
    "productName": "Voidisce",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Voidisce-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Voidisce-Portable.exe"
    },
    "files": [
      "**/*",
      "build/**/*",
      "!scripts/**"
    ]
  }
}
